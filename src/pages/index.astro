---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/products";
---

<BaseLayout
  title="Oaky AI — Thoughtful software"
  description="Oaky AI creates thoughtful digital products for music, motion, and everyday clarity."
  canonicalPath="/"
>
  <div class="home">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Oaky AI home">Oaky AI</a>
      <a class="product-count" href="#products">
        <span>Products</span>
        <span>{String(products.length).padStart(2, "0")}</span>
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Product studio</p>
          <h1 id="hero-title">Oaky AI</h1>
          <p class="statement">Thoughtful software for the way life is moving.</p>
        </div>

        <div class="hero-stage" aria-hidden="true">
          {products.map((product, index) => (
            <img
              class={`hero-icon hero-icon-${index + 1}`}
              src={product.image}
              alt=""
              width="768"
              height="768"
              loading="eager"
              decoding="async"
            />
          ))}
        </div>

        <a class="hero-scroll" href="#products">
          <span>Explore the work</span>
          <span aria-hidden="true">↓</span>
        </a>
      </section>

      <section class="products" id="products" aria-labelledby="products-title">
        <header class="products-intro">
          <p class="eyebrow">Selected products · {String(products.length).padStart(2, "0")}</p>
          <h2 id="products-title">Focused tools.<br />Distinct experiences.</h2>
        </header>

        <div class="product-list">
          {products.map((product, index) => (
            <a
              class={`product product-${product.tone}`}
              href={product.href}
              rel={product.external ? "external" : undefined}
              data-reveal
            >
              <div class="product-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>iOS</span>
              </div>

              <div class="product-media">
                <img
                  src={product.image}
                  alt={`${product.name} app icon`}
                  width="768"
                  height="768"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="product-copy">
                <p>{product.category}</p>
                <h3>{product.name}</h3>
                <div class="product-detail">
                  <span>{product.description}</span>
                  <span class="product-arrow" aria-hidden="true">↗</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <p>Oaky AI</p>
        <p>Designed for what comes next.</p>
      </div>
      <a href="mailto:contact.oaky@icloud.com">contact.oaky@icloud.com</a>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>

  <script is:inline>
    document.documentElement.classList.add("has-js");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealItems = document.querySelectorAll("[data-reveal]");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.16 },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>

<style>
  .home {
    overflow: clip;
    background: var(--color-canvas);
  }

  .site-header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 5.5rem;
    padding: 0 var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark,
  .product-count {
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .product-count {
    display: flex;
    gap: 1.15rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .product-count span:last-child {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .hero {
    position: relative;
    min-height: min(82svh, 55rem);
    padding: clamp(8rem, 17vh, 11rem) var(--page-gutter) 6rem;
    isolation: isolate;
    border-bottom: 1px solid var(--color-line);
  }

  .hero::after {
    content: "";
    position: absolute;
    z-index: -2;
    top: 0;
    bottom: 0;
    left: 50%;
    border-left: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 56rem;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-accent);
    font-size: 0.76rem;
    font-weight: 720;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(5.25rem, 14vw, 13rem);
    line-height: 0.8;
    font-weight: 760;
    letter-spacing: 0;
  }

  .statement {
    max-width: 22ch;
    margin: clamp(2.5rem, 6vw, 5rem) 0 0;
    color: var(--color-muted);
    font-size: clamp(1.35rem, 2.8vw, 2.45rem);
    line-height: 1.18;
  }

  .hero-stage {
    position: absolute;
    z-index: 1;
    right: clamp(-4rem, 1vw, 2rem);
    bottom: clamp(3.5rem, 8vh, 6rem);
    width: min(52vw, 48rem);
    height: min(58vh, 34rem);
    pointer-events: none;
  }

  .hero-icon {
    position: absolute;
    right: 7%;
    bottom: 0;
    width: clamp(11rem, 23vw, 21rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 22%;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.44);
    object-fit: cover;
    animation: icon-arrive 850ms cubic-bezier(0.2, 0.75, 0.2, 1) both;
  }

  .hero-icon-1 {
    z-index: 3;
    right: 47%;
    bottom: 5%;
    transform: rotate(-9deg);
    animation-delay: 80ms;
  }

  .hero-icon-2 {
    z-index: 2;
    right: 25%;
    bottom: 18%;
    transform: rotate(2deg);
    animation-delay: 180ms;
  }

  .hero-icon-3 {
    z-index: 1;
    transform: rotate(9deg);
    animation-delay: 280ms;
  }

  .hero-scroll {
    position: absolute;
    z-index: 3;
    bottom: 2.2rem;
    left: var(--page-gutter);
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .hero-scroll span:last-child {
    color: var(--color-text);
  }

  .products-intro {
    min-height: 48svh;
    padding: clamp(5rem, 10vw, 9rem) var(--page-gutter);
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
    align-items: start;
    gap: 3rem;
  }

  .products-intro h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.94;
    letter-spacing: 0;
  }

  .product {
    min-height: 70svh;
    padding: clamp(2rem, 5vw, 5rem) var(--page-gutter);
    display: grid;
    grid-template-columns: minmax(5rem, 0.3fr) minmax(15rem, 0.85fr) minmax(18rem, 1.3fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    color: var(--product-text);
    background: var(--product-background);
    text-decoration: none;
  }

  .product-warm {
    --product-background: #eee8df;
    --product-text: #221c17;
    --product-muted: #71675d;
    --product-line: #c9bfb4;
  }

  .product-dark {
    --product-background: #0d0e0c;
    --product-text: #f5f6ef;
    --product-muted: #969b91;
    --product-line: #30332d;
  }

  .product-stone {
    --product-background: #c9c4bd;
    --product-text: #211f1d;
    --product-muted: #68635e;
    --product-line: #aaa39a;
  }

  .product-meta {
    align-self: stretch;
    padding-top: 0.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--product-muted);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  .product-media {
    display: grid;
    place-items: center;
  }

  .product-media img {
    width: min(100%, 23rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 22%;
    object-fit: cover;
    box-shadow: 0 2rem 4.5rem color-mix(in srgb, var(--product-text) 20%, transparent);
    transition: transform 520ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .product-copy > p {
    margin: 0 0 1.25rem;
    color: var(--product-muted);
    font-size: 0.76rem;
    font-weight: 680;
    text-transform: uppercase;
  }

  .product-copy h3 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 8rem);
    line-height: 0.88;
    letter-spacing: 0;
  }

  .product-detail {
    margin-top: clamp(2.5rem, 5vw, 5rem);
    padding-top: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 30rem) auto;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--product-line);
    color: var(--product-muted);
    line-height: 1.55;
  }

  .product-arrow {
    color: var(--product-text);
    font-size: 1.5rem;
    transition: transform 260ms ease;
  }

  .product:hover .product-media img {
    transform: rotate(-2deg) scale(1.025);
  }

  .product:hover .product-arrow {
    transform: translate(0.3rem, -0.3rem);
  }

  .has-js .product[data-reveal] {
    opacity: 0;
    transform: translateY(2.5rem);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .has-js .product[data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .site-footer {
    min-height: 18rem;
    padding: clamp(3rem, 7vw, 6rem) var(--page-gutter);
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: 3rem;
    color: var(--color-muted);
    border-top: 1px solid var(--color-line);
    font-size: 0.86rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer p:first-child {
    margin-bottom: 0.3rem;
    color: var(--color-text);
    font-weight: 700;
  }

  .site-footer a {
    text-decoration: none;
  }

  @keyframes icon-arrive {
    from {
      opacity: 0;
      translate: 0 3rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 82svh;
      padding-top: 8rem;
    }

    .hero::after {
      display: none;
    }

    .hero-stage {
      right: -7vw;
      bottom: 4rem;
      width: 78vw;
      height: 43vh;
    }

    .hero-icon {
      width: clamp(9rem, 34vw, 17rem);
    }

    .products-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product {
      min-height: 76svh;
      grid-template-columns: 4rem minmax(12rem, 0.8fr) minmax(16rem, 1.2fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      min-height: 4.5rem;
    }

    .hero {
      min-height: 82svh;
      padding-top: 7.5rem;
    }

    h1 {
      font-size: clamp(5rem, 25vw, 8rem);
    }

    .statement {
      max-width: 16ch;
      font-size: 1.35rem;
    }

    .hero-stage {
      right: -10vw;
      bottom: 4.2rem;
      width: 94vw;
      height: 34vh;
    }

    .hero-icon {
      width: 38vw;
    }

    .hero-icon-1 {
      right: 50%;
    }

    .hero-icon-2 {
      right: 27%;
    }

    .products-intro {
      min-height: 58svh;
      padding-top: 5rem;
      padding-bottom: 5rem;
      align-content: center;
    }

    .product {
      min-height: 88svh;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr;
      gap: 2rem;
      align-content: center;
    }

    .product-meta {
      min-height: auto;
      flex-direction: row;
    }

    .product-media img {
      width: min(66vw, 18rem);
    }

    .product-copy h3 {
      font-size: clamp(3.5rem, 17vw, 5.5rem);
    }

    .product-detail {
      margin-top: 2rem;
    }

    .site-footer {
      grid-template-columns: 1fr;
      align-content: end;
      gap: 1.5rem;
    }
  }

  @media (max-width: 700px) and (max-height: 720px) {
    .hero-icon {
      width: 30vw;
    }

    .hero-stage {
      right: -7vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-icon {
      animation: none;
    }

    .has-js .product[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .product-media img,
    .product-arrow {
      transition: none;
    }
  }
</style>
