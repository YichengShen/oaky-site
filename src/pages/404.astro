---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Oaky AI" description="The requested page could not be found.">
  <main>
    <p>404</p>
    <h1>Nothing here.</h1>
    <a href="/">Return to Oaky AI</a>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 100svh;
    padding: var(--page-gutter);
    display: grid;
    align-content: center;
  }

  p {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    margin: 0 0 2rem;
    font-size: clamp(3rem, 10vw, 8rem);
    line-height: 1;
    letter-spacing: 0;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }
</style>
